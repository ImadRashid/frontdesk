{
  "name": "frontdesk",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production node --env-file-if-exists=.env --disable-warning=ExperimentalWarning server/src/index.ts",
    "eval": "FD_KB_BUILTIN_ONLY=1 node --env-file-if-exists=.env --disable-warning=ExperimentalWarning eval/run.ts",
    "test": "node --disable-warning=ExperimentalWarning --test server/test/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.10.0",
    "@hono/node-server": "^1.14.0",
    "baileys": "7.0.0-rc14",
    "hono": "^4.7.0",
    "imapflow": "^1.0.190",
    "mailparser": "^3.7.2",
    "mammoth": "^1.13.0",
    "nodemailer": "^7.0.0",
    "pino": "^9.6.0",
    "qrcode": "^1.5.4",
    "unpdf": "^1.9.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/mailparser": "^3.4.5",
    "@types/node": "^22.10.0",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "lucide-react": "^0.460.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^7.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.7.0",
    "vite": "^8.3.8"
  },
  "version": "1.0.1"
}
